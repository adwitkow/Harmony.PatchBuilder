<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10.0</LangVersion>

    <PackageId>Harmony.PatchBuilder</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- don't ship a DLL -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- no lib/ folder warning -->

    <GITHUB_RUN_NUMBER Condition="'$(GITHUB_RUN_NUMBER)' == ''">0</GITHUB_RUN_NUMBER>
    <Version>1.3.0.$(GITHUB_RUN_NUMBER)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>adwitkow</Authors>
    <Description>Fluent builder for manual Harmony patch registration</Description>
    <RepositoryUrl>https://github.com/adwitkow/Harmony.PatchBuilder</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="**/*.cs"
          Exclude="obj/**;bin/**"
          Pack="true"
          PackagePath="contentFiles/cs/any/$(PackageId)/%(RelativeDir)"
          BuildAction="Compile" />
  </ItemGroup>

</Project>